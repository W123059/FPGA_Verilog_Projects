`timescale 1ns/1ns

module tb_rs485();

reg sys_clk;
reg sys_rst_n;
reg [9:0] rx;
reg key_w;
reg key_b;
wire tx;
wire re;
wire [3:0] led;

initial
    begin 
    sys_clk=1'b1;
    sys_rst_n<=1'b0;
    key_w<=1'b1;
    key_b<=1'b1;
    #20
    sys_rst_n<=1'b1;
    //流水灯
    #200_0000 key_w<=1'b0;
    #20 key_w<=1'b1;
    #20 key_w<=1'b0;
    #20 key_w<=1'b1;
    #20 key_w<=1'b0;
    #200 key_w<=1'b1;
    #20 key_w<=1'b0;
    #20 key_w<=1'b1;
    #20 key_w<=1'b0;
    #20 key_w<=1'b1;
        //呼吸灯
    #200_0000 key_b<=1'b0;
    #20 key_b<=1'b1;
    #20 key_b<=1'b0;
    #20 key_b<=1'b1;
    #20 key_b<=1'b0;
    #200 key_b<=1'b1;
    #20 key_b<=1'b0;
    #20 key_b<=1'b1;
    #20 key_b<=1'b0;
    #20 key_b<=1'b1;
            //呼吸灯
    #200_0000 key_b<=1'b0;
    #20 key_b<=1'b1;
    #20 key_b<=1'b0;
    #20 key_b<=1'b1;
    #20 key_b<=1'b0;
    #200 key_b<=1'b1;
    #20 key_b<=1'b0;
    #20 key_b<=1'b1;
    #20 key_b<=1'b0;
    #20 key_b<=1'b1;
            //呼吸灯
    #200_0000 key_b<=1'b0;
    #20 key_b<=1'b1;
    #20 key_b<=1'b0;
    #20 key_b<=1'b1;
    #20 key_b<=1'b0;
    #200 key_b<=1'b1;
    #20 key_b<=1'b0;
    #20 key_b<=1'b1;
    #20 key_b<=1'b0;
    #20 key_b<=1'b1;
    //流水灯
    #200_0000 key_w<=1'b0;
    #20 key_w<=1'b1;
    #20 key_w<=1'b0;
    #20 key_w<=1'b1;
    #20 key_w<=1'b0;
    #200 key_w<=1'b1;
    #20 key_w<=1'b0;
    #20 key_w<=1'b1;
    #20 key_w<=1'b0;
    #20 key_w<=1'b1;
    //流水灯
    #200_0000 key_w<=1'b0;
    #20 key_w<=1'b1;
    #20 key_w<=1'b0;
    #20 key_w<=1'b1;
    #20 key_w<=1'b0;
    #200 key_w<=1'b1;
    #20 key_w<=1'b0;
    #20 key_w<=1'b1;
    #20 key_w<=1'b0;
    #20 key_w<=1'b1;
    end
    
always #10 sys_clk=~sys_clk;    

defparam rs485_inst0.key_cnt_max=5;
defparam rs485_inst0.water_led_cnt_max=4000;
defparam rs485_inst1.water_led_cnt_max=4000;
defparam rs485_inst0.max_1us_max=4;
defparam rs485_inst0.max_1ms_max=9;
defparam rs485_inst0.max_1s_max=9;
defparam rs485_inst1.max_1us_max=4;
defparam rs485_inst1.max_1ms_max=9;
defparam rs485_inst1.max_1s_max=9;
defparam rs485_inst0.uart_bps_max=100_0000;
defparam rs485_inst1.uart_bps_max=100_0000;

//控制板
rs485 rs485_inst0
(.sys_clk(sys_clk),
.sys_rst_n(sys_rst_n),
.rx(),
.key_w(key_w),
.key_b(key_b),
.tx(tx),
.re(re),
.led()
);
//被控板
rs485 rs485_inst1
(.sys_clk(sys_clk),
.sys_rst_n(sys_rst_n),
.rx(tx),
.key_w(),
.key_b(),
.tx(),
.re(),
.led(led)
);

endmodule
