//rs232.v
module rs232
(input wire sys_clk,
input wire sys_rst_n,
input wire rx,
output wire tx);
 
wire [7:0] rx_data;
wire [7:0] rx_flag;

uart_rx
#(.uart_bps(14'd9600),
.clk_freq(26'd50_000_000))
uart_rx_inst
(.sys_clk(sys_clk),
.sys_rst_n(sys_rst_n),
.rx(rx),
.po_data(rx_data),
.po_flag(rx_flag));

uart_tx
#(.uart_bps(14'd9600),
.clk_freq(26'd50_000_000))
uart_tx_inst
(.sys_clk(sys_clk),
.sys_rst_n(sys_rst_n),
.pi_data(rx_data),
.pi_flag(rx_flag),
.tx(tx));

endmodule


//uart_rx.v
module uart_rx
#(parameter uart_bps=14'd9600,
                    clk_freq=26'd50_000_000)
(input wire sys_clk,
input wire sys_rst_n,
input wire rx,
output reg [7:0] po_data,
output reg po_flag);

reg rx_reg1;
reg rx_reg2;
reg rx_reg3;
reg start_flag;
reg work_en;
reg [15:0] baud_cnt;
reg bit_flag;
reg [3:0] bit_cnt;
reg [7:0] rx_data;  
reg rx_flag;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
rx_reg1<=1'b1;
else
rx_reg1<=rx;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
rx_reg2<=1'b1;
else
rx_reg2<=rx_reg1;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
rx_reg3<=1'b1;
else
rx_reg3<=rx_reg2;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
start_flag<=1'b0;
else if((rx_reg2==1'b0)&&(rx_reg3==1'b1)&&(work_en==1'b0))
start_flag<=1'b1;
//要表示下降沿，可使用滞后一拍的信号构造条件
//为了防止无效下降沿的出现还增加使能信号
else
start_flag<=1'b0;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
work_en<=1'b0;
else if(start_flag==1'b1)
work_en<=1'b1;
else if((bit_cnt==4'd8)&&(bit_flag==1'b1))
work_en<=1'b0;
else 
work_en<=work_en;

parameter baud_cnt_max=clk_freq/uart_bps;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
baud_cnt<=16'd0;
else if((baud_cnt==baud_cnt_max-1'b1)||(work_en==1'b0))
baud_cnt<=16'd0;
else 
baud_cnt<=baud_cnt+16'd1;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
bit_flag<=1'b0;
else if(baud_cnt==baud_cnt_max/2'd2-1'b1)
bit_flag<=1'b1;
else
bit_flag<=1'b0;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
bit_cnt<=4'd0;
else if((bit_cnt==4'd8)&&(bit_flag==1'b1))
bit_cnt<=4'd0;
else if(bit_flag==1'b1)
bit_cnt<=bit_cnt+4'd1;
else 
bit_cnt<=bit_cnt;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
rx_data<=8'd0;
else if((bit_cnt>=4'd1)&&(bit_cnt<=4'd8)&&(bit_flag==1'b1))
rx_data<=({rx_reg3,rx_data[7:1]});
//每次将原来的最高位及以后的作为新数据的次高位及以后

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
rx_flag<=1'b0;
else if ((bit_cnt==4'd8)&&(bit_flag==1'b1))
rx_flag<=1'b1;
else 
rx_flag<=1'b0;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
po_data<=8'd0;
else if(rx_flag==1'b1)
po_data<=rx_data;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
po_flag<=1'b0;
else
po_flag<=rx_flag;

endmodule


//uart_tx.v
module uart_tx
#(parameter uart_bps=14'd9600,
                    clk_freq=26'd50_000_000)
(input wire sys_clk,
input wire sys_rst_n,
input wire [7:0] pi_data,
input wire pi_flag,
output reg tx,
output reg work_en);

reg [15:0] baud_cnt;
reg bit_flag;
reg [3:0] bit_cnt;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
work_en<=1'b0;
else if(pi_flag==1'b1)
work_en<=1'b1;
else if((bit_cnt==4'd9)&&(bit_flag==1'b1))
work_en<=1'b0;
else
work_en<=work_en;

parameter baud_cnt_max=clk_freq/uart_bps;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
baud_cnt<=16'd0;
else if((baud_cnt==baud_cnt_max-16'd1)||(work_en==1'b0))
baud_cnt<=16'd0;
else
baud_cnt<=baud_cnt+16'd1;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
bit_flag<=1'b0;
else if(baud_cnt==baud_cnt_max-16'b1)
bit_flag<=1'b1;
else 
bit_flag<=1'b0;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
bit_cnt<=4'd0;
else if((bit_cnt==4'd9)&&(bit_flag==1'b1))
bit_cnt<=4'd0;
else if((bit_flag==1'b1)&&(work_en==1'b1))
bit_cnt<=bit_cnt+4'd1;

always @ (posedge sys_clk or negedge sys_rst_n)
if(sys_rst_n==1'b0)
tx<=1'b1;
else if(work_en==1'b1)
case(bit_cnt)
0:tx<=1'b0;
1:tx<=pi_data[0];
2:tx<=pi_data[1];
3:tx<=pi_data[2];
4:tx<=pi_data[3];
5:tx<=pi_data[4];
6:tx<=pi_data[5];
7:tx<=pi_data[6];
8:tx<=pi_data[7];
9:tx<=1'b1;//要注意时序逻辑与组合逻辑的区别
default tx<=tx;
endcase

endmodule
